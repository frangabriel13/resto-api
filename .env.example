# Puerto de la API (Next usa el 3000)
PORT=3001

# Postgres local (docker-compose.yml). Ver roles en docker/postgres/init/01-roles.sh
# Runtime de la API, sujeto a RLS
DATABASE_URL="postgresql://resto_app:app@localhost:5434/resto_club"
# Endpoints /admin y lectura pública de piezas (BYPASSRLS)
DATABASE_ADMIN_URL="postgresql://resto_app_admin:app_admin@localhost:5434/resto_club"
# Dueño de las tablas, solo para `prisma migrate`
MIGRATE_DATABASE_URL="postgresql://resto_migrator:migrator@localhost:5434/resto_club"

# development | test | production (por defecto: development)
NODE_ENV=development

# Opcional: contraseña del dueño y del empleado de la demo (`prisma db seed`).
# Por defecto: demo1234
# DEMO_STAFF_PASSWORD=
