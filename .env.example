# Puerto de la API (Next usa el 3000)
PORT=3001

# Postgres local (docker-compose.yml). Ver roles en docker/postgres/init/01-roles.sh
# Runtime de la API, sujeto a RLS
DATABASE_URL="postgresql://resto_app:app@localhost:5434/resto_club"
# Endpoints /admin y lectura pública de piezas (BYPASSRLS)
DATABASE_ADMIN_URL="postgresql://resto_app_admin:app_admin@localhost:5434/resto_club"
# Dueño de las tablas, solo para `prisma migrate`
MIGRATE_DATABASE_URL="postgresql://resto_migrator:migrator@localhost:5434/resto_club"

# development | test | production (por defecto: development)
NODE_ENV=development

# Opcional: contraseña del dueño y del empleado de la demo (`prisma db seed`).
# Por defecto: demo1234
# DEMO_STAFF_PASSWORD=

# Clave del servidor para HMAC (códigos OTP, token del QR). Mínimo 32 caracteres.
# Generarla con: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SECRET_KEY=
# Clave para cifrar las contraseñas NFC de las piezas: 64 caracteres hexadecimales.
# Generarla con: openssl rand -hex 32
# Si se pierde, las contraseñas no se recuperan: guardarla con los secretos.
NFC_PASSWORD_KEY=
# Envío de códigos OTP: console (solo desarrollo; en producción la API no arranca con este valor)
# o whatsapp (Cloud API de Meta; necesita las variables WHATSAPP_*)
OTP_SENDER=console
# ID del número que manda los códigos (Meta › WhatsApp › Configuración de la API)
# WHATSAPP_PHONE_NUMBER_ID=
# Token de acceso de Meta. En producción, el permanente de un usuario del sistema
# WHATSAPP_ACCESS_TOKEN=
# Plantilla de autenticación aprobada (con botón "Copiar código") y su idioma
# WHATSAPP_TEMPLATE_NAME=
# Por defecto: es_AR
# WHATSAPP_TEMPLATE_LANGUAGE=es_AR
# Envío de mails (recuperación de contraseña del dueño): console (solo desarrollo)
# o resend (necesita RESEND_API_KEY y EMAIL_FROM)
EMAIL_SENDER=console
# API key de Resend con permiso "Sending access"
# RESEND_API_KEY=
# Remitente, de un dominio verificado en Resend. Sin dominio (solo pruebas, y solo
# al email de la cuenta de Resend): Clubsy <onboarding@resend.dev>
# EMAIL_FROM="Clubsy <no-reply@dominio>"
# URL del front, para los links de los mails (en producción, https)
APP_URL=http://localhost:3000
# Imágenes (portada y logo) en Cloudflare R2: van todas juntas y en producción
# son obligatorias. Sin ellas la API levanta, pero no se pueden subir imágenes.
# En desarrollo, el bucket clubsy-imagenes-dev con su propio token.
# Account ID de Cloudflare (32 caracteres hexadecimales)
# R2_ACCOUNT_ID=
# Token de R2 con "Object Read & Write", limitado al bucket
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=clubsy-imagenes-dev
# Desde donde se ven las imágenes (el dominio del bucket o su URL r2.dev), sin / al final
# IMAGES_PUBLIC_URL=https://pub-xxxx.r2.dev
# Sentry: sin DSN queda apagado. En producción es obligatorio.
# Probar la conexión con: pnpm sentry:check
# SENTRY_DSN=
# Por defecto, el NODE_ENV
# SENTRY_ENVIRONMENT=
# Fracción de requests con trazas de performance (0 a 1). Por defecto 0
# SENTRY_TRACES_SAMPLE_RATE=0
