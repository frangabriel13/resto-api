# Variables de los E2E (`pnpm test:e2e`). Apuntan a la base `resto_club_test`
# del Postgres de docker-compose: solo credenciales locales de desarrollo.
# Las variables ya definidas en el entorno tienen prioridad sobre este archivo,
# pero las tres URLs tienen que apuntar a una base terminada en `_test`.
NODE_ENV=test
DATABASE_URL="postgresql://resto_app:app@localhost:5434/resto_club_test"
DATABASE_ADMIN_URL="postgresql://resto_app_admin:app_admin@localhost:5434/resto_club_test"
MIGRATE_DATABASE_URL="postgresql://resto_migrator:migrator@localhost:5434/resto_club_test"
